exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders canvas-title in dark 1`] = `"<section class="slide is-on" data-slide="canvas-title" data-kind="content"><div class="in"><div class="freeform" data-slot="main"><div class="free" data-free="mark" style="left:0px;top:159px;width:132px;height:84px;z-index:1"><svg width="132" height="84" fill="currentColor" data-block="mark" data-type="mark" aria-hidden="true" data-raster="mark" data-rid="mark:1"><use href="#gt-mark"/></svg></div><div class="free" data-free="heading" style="left:0px;top:291px;width:901px;height:90px;z-index:2"><h1 data-block="heading" data-type="heading" data-run="heading/text">A title slide as a canvas</h1></div><div class="free" data-free="lead" style="left:0px;top:407px;width:901px;height:75px;z-index:3"><p class="lead muted max-p" data-block="lead" data-type="paragraph" data-run="lead/text">The mark, the heading and this lead are objects; a text box grows, another shrinks, a shape holds padded text and an icon sits beside it.</p></div><div class="free" data-free="grow" style="left:0px;top:511px;width:520px;height:60px;z-index:4"><p class="text" style="padding:16px;height:100%;box-sizing:border-box" data-block="grow" data-type="text" data-run="grow/text">A text box that resizes to fit its text</p></div><div class="free" data-free="shrink" style="left:563px;top:511px;width:420px;height:80px;z-index:5"><p class="text" style="font-size:26px;padding:16px;height:100%;box-sizing:border-box" data-block="shrink" data-type="text" data-run="shrink/text">A text box with shrink text on overflow: the copy is long enough at 26 px that the fit steps the size down the ladder to 24 or 22 before it fits the box it was given.</p></div><div class="free" data-free="padded" style="left:1023px;top:491px;width:300px;height:120px;z-index:6" aria-label="A rounded rectangle holding a short label"><div class="shape-block" data-block="padded" data-type="shape"><svg viewBox="0 0 300 120" width="300" height="120" preserveAspectRatio="none" class="shape shape-roundRect" data-raster="dia" data-rid="padded:1" data-shape="roundRect" aria-hidden="true"><path d="M0,0 H299 V119 H0 Z" fill="none" stroke="var(--ink)" stroke-width="1" stroke-linejoin="miter" transform="translate(0.5 0.5)"/></svg><div class="shape-text" style="left:0px;top:0px;width:300px;height:120px;padding:8px 24px 8px 24px;text-align:center;display:flex;flex-direction:column;justify-content:center" data-run="padded/text">Padded, middle aligned</div></div></div><div class="free" data-free="icon" style="left:1263px;top:160px;width:48px;height:48px;z-index:7"><svg class="ic icon-block" data-block="icon" data-type="icon" aria-hidden="true" data-raster="icon" data-rid="icon:1"><use href="#i-check-circle"/></svg></div></div></div></section>"`;

