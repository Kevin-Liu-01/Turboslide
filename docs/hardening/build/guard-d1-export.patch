+# The weekly accounts export (hardening O#1b; docs/hosting.md section 15): the guard checkout's
+# scripts/hosting/d1-export.mjs with the workspace's wrangler and the account id in the child's
+# environment. The script decides whether an export is due (the newest file a week old, no failed
+# attempt in the last six hours), so a poll that finds nothing due costs one directory read and
+# logs nothing. Its one line of output names the file and its size, or wrangler's exit code with
+# every line that names a token dropped; nothing of the database reaches the log. A checkout
+# before the script landed has no such file, and the step is skipped.
+BACKUPS=$DIR/backups
+accounts_export() {
+  local script=$WT/scripts/hosting/d1-export.mjs dir=$WT/$WORKER_DIR out=$GUARD/accounts-export.out
+  [ -f "$script" ] || return 0
+  cf_env
+  local envp=() code
+  [ -n "$CF_ACCOUNT_ID" ] && envp=("CLOUDFLARE_ACCOUNT_ID=$CF_ACCOUNT_ID")
+  (cd "$WT" && env -u VERCEL_OIDC_TOKEN "${envp[@]}" node "$script" --dir "$BACKUPS" --every-days 7 --keep 8 --retry-hours 6 --cwd "$dir" --wrangler "$dir/node_modules/.bin/wrangler") > "$out" 2>&1
+  code=$?
+  if [ $code -ne 0 ]; then
+    log "accounts export failed (exit $code): $(grep -v '^$' "$out" | scrub | tail -1 | cut -c1-240)"
+  elif grep -q '^wrote ' "$out"; then
+    log "accounts export: $(grep '^wrote ' "$out" | scrub | cut -c1-240)"
+  fi
+  return 0
+}
+
