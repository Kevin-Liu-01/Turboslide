{
  "name": "@turboslide/store",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The DeckStore contract and the FileStore over decks/<id>: reads the manifest and slides, applies writes through the reducer with the baseRevision check, keeps the version log under versions/, advisory leases and a watch channel over fs.watch (MILESTONES M2 item 1; SPEC 4.1, 6.7, 11). The hosted backends beside it: store selection from the environment (select.ts), the bundled seed (seed.ts), the per-instance overlay (tmp-store.ts) and the Vercel Blob mirror (blob-store.ts, blob-vercel.ts) behind one collection (hosted.ts).",
  "scripts": {
    "test": "vitest run"
  },
  "exports": {
    "./store": "./src/store.ts",
    "./file-store": "./src/file-store.ts",
    "./versions": "./src/versions.ts",
    "./lease": "./src/lease.ts",
    "./watch": "./src/watch.ts",
    "./templates": "./src/templates.ts",
    "./select": "./src/select.ts",
    "./seed": "./src/seed.ts",
    "./hosted": "./src/hosted.ts",
    "./access-store": "./src/access-store.ts",
    "./comments-store": "./src/comments-store.ts",
    "./presence-store": "./src/presence-store.ts",
    "./pulse": "./src/pulse.ts",
    "./inbox": "./src/inbox.ts",
    "./migrate": "./src/migrate.ts",
    "./tmp-store": "./src/tmp-store.ts",
    "./blob-store": "./src/blob-store.ts",
    "./snapshots": "./src/snapshots.ts",
    "./blob-fake": "./src/blob-fake.ts",
    "./blob-disk": "./src/blob-disk.ts",
    "./blob-vercel": "./src/blob-vercel.ts",
    "./zip": "./src/zip.ts",
    "./bundle": "./src/bundle.ts",
    "./pack": "./src/pack.ts",
    "./unpack": "./src/unpack.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@turboslide/schema": "workspace:*",
    "@vercel/blob": "catalog:",
    "zod": "catalog:"
