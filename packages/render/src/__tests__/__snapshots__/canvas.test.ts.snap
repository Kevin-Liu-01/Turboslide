exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders bullets in dark 1`] = `"<section class="slide is-on" data-slide="bullets" data-kind="content"><div class="in"><div class="cols even"><div class="stack" data-slot="left"><h2 data-block="h" data-type="heading" data-run="h/text">Bullets and numbering</h2><div class="plain marked bulleted" data-block="bullets" data-type="plain" data-marker="bullet" data-preset="disc-circle-square"><span class="item"><span class="num glyph" data-num="bullets/items/0">●</span><span data-run="bullets/items/0/text">Level one, a disc</span></span><span class="item" data-level="2" style="padding-left:36px"><span class="num glyph" data-num="bullets/items/1">○</span><span data-run="bullets/items/1/text">Level two, a circle</span></span><span class="item" data-level="3" style="padding-left:72px"><span class="num glyph" data-num="bullets/items/2">■</span><span data-run="bullets/items/2/text">Level three, a square</span></span><span class="item" data-level="4" style="padding-left:108px"><span class="num glyph" data-num="bullets/items/3">●</span><span data-run="bullets/items/3/text">Level four, the glyph cycle starts again</span></span></div></div><div class="stack" data-slot="right"><div class="plain marked numbered" data-block="numbers" data-type="plain" data-marker="number" data-preset="digit-alpha-roman"><span class="item"><span class="num" data-num="numbers/items/0">1.</span><span data-run="numbers/items/0/text">A digit at level one</span></span><span class="item" data-level="2" style="padding-left:36px"><span class="num" data-num="numbers/items/1">a.</span><span data-run="numbers/items/1/text">A letter at level two</span></span><span class="item" data-level="3" style="padding-left:72px"><span class="num" data-num="numbers/items/2">i.</span><span data-run="numbers/items/2/text">A roman numeral at level three</span></span><span class="item"><span class="num" data-num="numbers/items/3">2.</span><span data-run="numbers/items/3/text">Back to a digit</span></span></div><div class="plain numbered" data-block="ruled" data-type="plain"><span class="item"><span class="num" data-num="ruled/items/0">1</span><span data-run="ruled/items/0/text">The round one form</span></span><span class="item"><span class="num" data-num="ruled/items/1">2</span><span data-run="ruled/items/1/text">A tabular numeral in the key position</span></span></div></div></div></div></section>"`;

