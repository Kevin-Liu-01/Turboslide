+# Whether the production Worker already runs the push's bundle (hardening HR-RT#18): the tree's
+# hash (scripts/hosting/worker-hash.mjs --env production, 64 hex) equals the `bundle` that the
+# production Worker's /health answers. 0 the same bundle (no deploy, so no editor's socket
+# closes), 1 another, an empty or an unreadable one (the Worker deploys as before). Sets
+# WORKER_HASH_NOTE for the log.
+WORKER_HASH_NOTE=
+worker_kept() {
+  local hash live
+  if [ ! -f "$WT/scripts/hosting/worker-hash.mjs" ]; then WORKER_HASH_NOTE="the tree has no worker-hash.mjs"; return 1; fi
+  hash=$(cd "$WT" && node scripts/hosting/worker-hash.mjs --env production 2>/dev/null)
+  if ! [[ $hash =~ ^[0-9a-f]{64}$ ]]; then WORKER_HASH_NOTE="the tree's bundle hash could not be read"; return 1; fi
+  live=$(curl -s -S --max-time 10 "https://$(cf_host production)/health" 2>/dev/null | node -e 'let t="";process.stdin.on("data",d=>t+=d).on("end",()=>{let b="";try{const j=JSON.parse(t);if(typeof j.bundle==="string")b=j.bundle;}catch{}console.log(b);});')
+  if [ "$live" = "$hash" ]; then WORKER_HASH_NOTE="bundle ${hash:0:12} unchanged"; return 0; fi
+  local shown=${live:0:12}
+  WORKER_HASH_NOTE="bundle ${hash:0:12}, production answers ${shown:-none}"
+  return 1
 }
