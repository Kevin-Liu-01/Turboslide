exports[`the parity round render cases in both themes > renders the table block (dark) 1`] = `"<div class="table" style="--table-cols:minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr)" data-block="table" data-type="table" role="table"><div class="tr header"><span class="td first" data-run="table/rows/0/cells/0"><span class="para">Plan</span></span><span class="td" style="text-align:right" data-run="table/rows/0/cells/1"><span class="para">Seats</span></span><span class="td" style="text-align:right" data-run="table/rows/0/cells/2"><span class="para">Locales</span></span><span class="td last" style="text-align:right" data-run="table/rows/0/cells/3"><span class="para">Price</span></span></div><div class="tr"><span class="td first" data-run="table/rows/1/cells/0"><span class="para">Starter</span></span><span class="td" style="text-align:right" data-run="table/rows/1/cells/1"><span class="para">5</span></span><span class="td" style="text-align:right" data-run="table/rows/1/cells/2"><span class="para">2</span></span><span class="td last" style="text-align:right" data-run="table/rows/1/cells/3"><span class="para">$0</span></span></div><div class="tr"><span class="td first" data-run="table/rows/2/cells/0"><span class="para">Team</span></span><span class="td" style="text-align:right" data-run="table/rows/2/cells/1"><span class="para">25</span></span><span class="td" style="text-align:right" data-run="table/rows/2/cells/2"><span class="para">10</span></span><span class="td last" style="text-align:right" data-run="table/rows/2/cells/3"><span class="para">$99</span></span></div></div>"`;

