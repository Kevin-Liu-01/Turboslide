    "@turboslide/schema": "workspace:*",
    "@turboslide/theme": "workspace:*",
    "@turboslide/viewer": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
