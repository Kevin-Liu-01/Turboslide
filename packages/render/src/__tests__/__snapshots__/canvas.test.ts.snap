exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders spacing in dark 1`] = `"<section class="slide is-on" data-slide="spacing" data-kind="content"><div class="in"><div class="stack" data-slot="main" style="gap:22px"><h2 data-block="h" data-type="heading" data-run="h/text">Spacing, columns and indent</h2><p style="line-height:1.5;column-count:2;column-gap:40px;--para-before:12px;--para-after:12px" data-block="spaced" data-type="paragraph" data-run="spaced/text"><span class="para">The first paragraph of a two column block at line spacing 1.5.</span><span class="para">The second paragraph follows 12 px of space before it and leaves 12 px after.</span><span class="para">The third paragraph fills the second column when the first is full.</span></p><p class="max-p" style="padding-left:64px" data-block="indented" data-type="paragraph" data-run="indented/text">An indented paragraph, 64 px in from the left edge of the block.</p></div></div></section>"`;

exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders spacing in light 1`] = `"<section class="slide is-on" data-slide="spacing" data-kind="content"><div class="in"><div class="stack" data-slot="main" style="gap:22px"><h2 data-block="h" data-type="heading" data-run="h/text">Spacing, columns and indent</h2><p style="line-height:1.5;column-count:2;column-gap:40px;--para-before:12px;--para-after:12px" data-block="spaced" data-type="paragraph" data-run="spaced/text"><span class="para">The first paragraph of a two column block at line spacing 1.5.</span><span class="para">The second paragraph follows 12 px of space before it and leaves 12 px after.</span><span class="para">The third paragraph fills the second column when the first is full.</span></p><p class="max-p" style="padding-left:64px" data-block="indented" data-type="paragraph" data-run="indented/text">An indented paragraph, 64 px in from the left edge of the block.</p></div></div></section>"`;

exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders styles in dark 1`] = `"<section class="slide is-on" data-slide="styles" data-kind="content"><div class="in"><div class="stack" data-slot="main" style="gap:22px"><h2 data-block="h" data-type="heading" data-run="h/text">Text styles</h2><p class="max-p" data-block="p1" data-type="paragraph" data-run="p1/text">A run in <i>italic</i>, one <u>underlined</u>, one <s>struck through</s>, E = mc<sup>2</sup>, H<sub>2</sub>O, a <span style="color:#12a37a">coloured</span> run and a <mark style="background:#f0a020">highlighted</mark> run.</p><p class="text" style="text-align:justify" data-block="justified" data-type="text" data-run="justified/text">A justified text box sets every line but the last to the full measure. The word spaces stretch so both edges of the block are straight, which is what Google Slides does for the fourth alignment button.</p></div></div></section>"`;

exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders styles in light 1`] = `"<section class="slide is-on" data-slide="styles" data-kind="content"><div class="in"><div class="stack" data-slot="main" style="gap:22px"><h2 data-block="h" data-type="heading" data-run="h/text">Text styles</h2><p class="max-p" data-block="p1" data-type="paragraph" data-run="p1/text">A run in <i>italic</i>, one <u>underlined</u>, one <s>struck through</s>, E = mc<sup>2</sup>, H<sub>2</sub>O, a <span style="color:#12a37a">coloured</span> run and a <mark style="background:#f0a020">highlighted</mark> run.</p><p class="text" style="text-align:justify" data-block="justified" data-type="text" data-run="justified/text">A justified text box sets every line but the last to the full measure. The word spaces stretch so both edges of the block are straight, which is what Google Slides does for the fourth alignment button.</p></div></div></section>"`;

exports[`the export fixture deck of SPEC-2 11.2 in both themes > renders table-merge in dark 1`] = `"<section class="slide is-on" data-slide="table-merge" data-kind="content"><div class="in"><div class="split"><div class="head head-cols head-4-8" data-slot="head"><h2 data-block="h" data-type="heading" data-run="h/text">Merged cells</h2></div><div class="body" data-slot="body"><div class="table grid" style="--table-cols:minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);--table-rule-style:dashed;grid-template-rows:56px 56px 56px 56px" data-block="table" data-type="table" role="table" data-dash="dash"><div class="tr header"><span class="td first" style="background:var(--plate);border-bottom:1px dashed var(--ink)" data-run="table/rows/0/cells/0"><span class="para">Region</span></span><span class="td right" style="border-bottom:1px dashed var(--ink)" data-run="table/rows/0/cells/1"><span class="para">Q1</span></span><span class="td right" style="border-bottom:1px dashed var(--ink)" data-run="table/rows/0/cells/2"><span class="para">Q2</span></span><span class="td right last" style="border-bottom:1px dashed var(--ink)" data-run="table/rows/0/cells/3"><span class="para">Q3</span></span></div><div class="tr"><span class="td first" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/1/cells/0"><span class="para">North</span></span><span class="td right" style="grid-row:span 2;grid-column:span 2;border-bottom:1px dashed var(--hair)" data-run="table/rows/1/cells/1" data-span="2x2"><span class="para">One merged cell over four</span></span><span class="td right last" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/1/cells/3"><span class="para">1,200</span></span></div><div class="tr"><span class="td first" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/2/cells/0"><span class="para">South</span></span><span class="td right last" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/2/cells/3"><span class="para">980</span></span></div><div class="tr"><span class="td first" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/3/cells/0"><span class="para">West</span></span><span class="td right" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/3/cells/1"><span class="para">410</span></span><span class="td right" style="border-bottom:1px dashed var(--hair)" data-run="table/rows/3/cells/2"><span class="para">460</span></span><span class="td right last" style="border-bottom:0" data-run="table/rows/3/cells/3"><span class="para">520</span></span></div></div></div></div></div></section>"`;

