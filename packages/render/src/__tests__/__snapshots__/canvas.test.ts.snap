Ratio="none" class="shape shape-wedgeRectCallout" data-raster="dia" data-rid="callout:1" data-shape="wedgeRectCallout" aria-hidden="true" data-adjust="-30000,70000"><path d="M0,0 H339 V179 H0 Z" fill="none" stroke="var(--ink)" stroke-width="1" stroke-linejoin="miter" transform="translate(0.5 0.5)"/></svg><div class="shape-text" style="left:0px;top:0px;width:340px;height:180px;padding:16px;display:flex;flex-direction:column;justify-content:center" data-run="callout/text">A callout with its wedge moved</div></div></div><div class="free" data-free="plus" style="left:1060px;top:131px;width:220px;height:220px;z-index:5"><svg viewBox="0 0 220 220" width="220" height="220" preserveAspectRatio="none" class="shape shape-mathPlus" data-block="plus" data-type="shape" data-raster="dia" data-rid="plus:1" data-shape="mathPlus" aria-hidden="true"><path d="M0,0 H219 V219 H0 Z" fill="var(--ink)" stroke="var(--ink)" stroke-width="1" stroke-linejoin="miter" transform="translate(0.5 0.5)"/></svg></div><div class="free" data-free="snip" style="left:0px;top:411px;width:420px;height:180px;z-index:6"><div class="shape-block" data-block="snip" data-type="shape"><svg viewBox="0 0 420 180" width="420" height="180" preserveAspectRatio="none" class="shape shape-snip1Rect" data-raster="dia" data-rid="snip:1" data-shape="snip1Rect" aria-hidden="true"><path d="M0,0 H419 V179 H0 Z" fill="none" stroke="var(--ink)" stroke-width="1" stroke-linejoin="miter" transform="translate(0.5 0.5)"/></svg><div class="shape-text" style="left:0px;top:0px;width:420px;height:180px;padding:16px" data-run="snip/text">Snipped corner</div></div></div><div class="free" data-free="dashed" style="left:480px;top:411px;width:420px;height:180px;z-index:7"><svg viewBox="0 0 420 180" width="420" height="180" preserveAspectRatio="none" class="shape shape-ellipse" data-block="dashed" data-type="shape" data-raster="dia" data-rid="dashed:1" data-shape="ellipse" aria-hidden="true"><ellipse cx="210" cy="90" rx="209" ry="89" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="8 6"/></svg></div></div></div></section>"`;

