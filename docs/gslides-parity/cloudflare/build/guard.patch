+# the Cloudflare phase of the realtime round (docs/CLOUDFLARE.md 5.6): the environment names, the
+# tree's tier expectation, the realtime rows' rule, the account facts and the Worker steps
+
+# The variable names of one environment of turboslide-gt, one per line, from `vercel env ls
+# <environment> --json` run in the worktree (the JSON carries no value for a sensitive or an
+# encrypted row; only `key` is read, so nothing here can print a value). Returns 2 when the CLI
+# failed or answered no list.
+env_names() {
+  local raw
+  raw=$(cd "$WT" && env -u VERCEL_OIDC_TOKEN vercel env ls "$1" --json --scope "$SCOPE" 2>/dev/null) || return 2
+  printf '%s' "$raw" | node -e 'let t="";process.stdin.on("data",d=>t+=d).on("end",()=>{let rows=null;try{const j=JSON.parse(t);rows=Array.isArray(j)?j:(j&&Array.isArray(j.envs)?j.envs:null);}catch{rows=null;}if(rows===null)process.exit(2);for(const r of rows)if(r&&typeof r.key==="string")console.log(r.key);});'
+}
+# 0 when the name is among the environment's variables, 1 when absent, 2 when the names could
+# not be read (an empty list reads as unreadable: every environment of the project carries rows).
+has_env_name() {
+  local names
+  names=$(env_names "$1") || return 2
+  [ -n "$names" ] || return 2
+  printf '%s\n' "$names" | grep -q -x -F -- "$2"
+}
+# What the checked out tree expects of production's realtime tier: the `realtime` word of
+# scripts/hosting/production.json (`blob`, `redis` or `do`), `blob` when the file is absent or
+# unreadable (the tier a deployment without a channel selects on its own, packages/realtime/src/select.ts).
+tree_expects() {
+  node -e 'const fs=require("fs");try{const j=JSON.parse(fs.readFileSync(process.argv[1],"utf8"));console.log(["blob","redis","do"].includes(j.realtime)?j.realtime:"blob");}catch{console.log("blob");}' "$WT/scripts/hosting/production.json"
+}
+# The spec rows for a check of an origin: SPEC_ROWS, plus REALTIME_ROWS when the tree's matrix
+# carries the first of them (by its quoted id), the tree expects `do` and the deployment's
+# environment (preview for a preview deployment, production for production itself) names
+# TURBOSLIDE_ROOM_HOST. Sets SPEC_ROWS_FOR (the rows) and ROWS_NOTE (the sentence for the log);
+# called directly, never in a command substitution, so both reach the caller.
+SPEC_ROWS_FOR=
+ROWS_NOTE=
+spec_rows_for() {
+  local origin=$1 environment=preview
+  [ "$origin" = "$PROD" ] && environment=production
+  SPEC_ROWS_FOR=$SPEC_ROWS
+  ROWS_NOTE=
+  if ! grep -q -F "\"${REALTIME_ROWS%%,*}\"" "$WT/docs/gslides-parity/focus/core-matrix.json" 2>/dev/null; then
+    ROWS_NOTE="realtime rows skipped: not in the tree's matrix"; return 0
+  fi
+  local expects; expects=$(tree_expects)
+  if [ "$expects" != do ]; then
+    ROWS_NOTE="realtime rows skipped: the tree expects the $expects tier (scripts/hosting/production.json)"; return 0
+  fi
+  has_env_name "$environment" "$ROOM_HOST_VARIABLE"
+  case $? in
+    0) ROWS_NOTE="realtime rows joined: the tree expects do and $ROOM_HOST_VARIABLE is among the $environment environment names"; SPEC_ROWS_FOR="$SPEC_ROWS,$REALTIME_ROWS" ;;
+    1) ROWS_NOTE="realtime rows skipped: $ROOM_HOST_VARIABLE absent from the $environment environment names" ;;
+    *) ROWS_NOTE="realtime rows skipped: the $environment environment names could not be read (vercel env ls)" ;;
+  esac
+  return 0
+}
+# The account facts of cloudflare.env (CLOUDFLARE_ACCOUNT_ID, TURBOSLIDE_ROOM_HOST and
+# TURBOSLIDE_ROOM_HOST_PREVIEW; none a secret) read into three shell variables, never exported;
+# the account id reaches the wrangler child alone. cf_host prints the Worker's hostname for an
+# environment, with the hosts of docs/CLOUDFLARE.md 3.1 when the file does not name them.
+CF_ACCOUNT_ID=
+CF_HOST_PRODUCTION=
+CF_HOST_PREVIEW=
+cf_env() {
+  [ -f "$CF_ENV" ] || return 0
+  local line k v
+  while IFS= read -r line || [ -n "$line" ]; do
+    case $line in ''|'#'*) continue ;; esac
+    k=${line%%=*}; v=${line#*=}; v=${v%\"}; v=${v#\"}
+    case $k in
+      CLOUDFLARE_ACCOUNT_ID) CF_ACCOUNT_ID=$v ;;
+      TURBOSLIDE_ROOM_HOST) CF_HOST_PRODUCTION=$v ;;
+      TURBOSLIDE_ROOM_HOST_PREVIEW) CF_HOST_PREVIEW=$v ;;
+    esac
+  done < "$CF_ENV"
+}
+cf_host() {
+  cf_env
+  if [ "$1" = preview ]; then echo "${CF_HOST_PREVIEW:-turboslide-realtime-preview.kk23907751.workers.dev}"; else echo "${CF_HOST_PRODUCTION:-turboslide-realtime.kk23907751.workers.dev}"; fi
+}
+# Whether a push changed the Worker's code: a path of WORKER_PATHS_RE between the last deployed
+# sha and this one. An empty or unknown base reads as touched (the conservative reading; docs_only
+# reads the same case as a whole check).
+worker_touched() {
+  local base=$1 sha=$2
+  [ -n "$base" ] || return 0
+  git -C "$WT" cat-file -e "$base^{commit}" 2>/dev/null || return 0
+  git -C "$WT" diff --name-only "$base" "$sha" 2>/dev/null | grep -q -E "$WORKER_PATHS_RE"
+}
+# One Worker deploy: $1 environment (preview|production), $2 sha, $3 the app origin for the
+# preview (empty for production, whose origin is fixed in wrangler.jsonc), $4 the output file.
+# Runs the workspace's wrangler through pnpm from the worktree's apps/realtime-worker (never a
+# global one) with the account id in the child's environment and the output scrubbed; the --var
+# pairs are the sha and, on the preview, the app origin (docs/CLOUDFLARE.md 5.6 item 1); the
+# production deploy passes --env "" to name the top level environment on purpose (wrangler warns
+# otherwise). Sets WORKER_NOTE; 0 deployed, 2 error (wrangler absent from the worktree's
+# node_modules, or the deploy failed).
+WORKER_NOTE=
+worker_deploy() {
+  local environment=$1 sha=$2 origin=$3 out=$4
+  local dir=$WT/$WORKER_DIR
+  if [ ! -x "$dir/node_modules/.bin/wrangler" ]; then
+    WORKER_NOTE="wrangler is not installed in $dir (node_modules/.bin/wrangler); run pnpm install --frozen-lockfile in $WT once, the Worker's dependencies are in the lockfile"; return 2
+  fi
+  cf_env
+  local envflag=('--env' '') vars=('--var' "TURBOSLIDE_BUILD_COMMIT:$sha") envp=()
+  [ "$environment" = preview ] && envflag=('--env' 'preview')
+  [ -n "$origin" ] && vars+=('--var' "TURBOSLIDE_APP_ORIGIN:$origin")
+  [ -n "$CF_ACCOUNT_ID" ] && envp=("CLOUDFLARE_ACCOUNT_ID=$CF_ACCOUNT_ID")
+  (cd "$dir" && env -u VERCEL_OIDC_TOKEN "${envp[@]}" pnpm exec wrangler deploy "${envflag[@]}" "${vars[@]}") > "$out" 2>&1
+  local code=$?
+  if [ $code -ne 0 ]; then
+    WORKER_NOTE="wrangler deploy ${envflag[*]} for $sha exit $code: $(grep -v '^$' "$out" | scrub | tail -2 | tr '\n' ' ' | cut -c1-240)"; return 2
+  fi
+  WORKER_NOTE="wrangler deploy ${envflag[*]} for $sha: $(grep -E 'Deployed|Version ID|Current Version' "$out" | scrub | tr '\n' ' ' | cut -c1-200)"
+  return 0
+}
+# GET https://<host>/health with a 10 s deadline: 0 when ok is true, commit equals the sha and,
+# when $3 is given, appOrigin equals it; 1 on a mismatch, 2 when unreachable or not JSON. Sets
+# WORKER_HEALTH to the reading. Three tries 10 s apart, since a deploy propagates.
+WORKER_HEALTH=
+worker_health() {
+  local host=$1 sha=$2 origin=$3 n=0 body code
+  while :; do
+    body=$(curl -s -S --max-time 10 "https://$host/health" 2>&1)
+    WORKER_HEALTH=$(printf '%s' "$body" | node -e 'let t="";process.stdin.on("data",d=>t+=d).on("end",()=>{let j;try{j=JSON.parse(t);}catch{console.log("unreachable: "+t.replace(/\s+/g," ").slice(0,160));process.exit(2);}const want=process.argv[1],origin=process.argv[2];console.log(`/health ok ${j.ok} commit ${j.commit||"(empty)"} realtime ${j.realtime} appOrigin ${j.appOrigin||"(empty)"}`);if(j.ok!==true||j.commit!==want||(origin&&j.appOrigin!==origin))process.exit(1);});' "$sha" "$origin")
+    code=$?
+    [ $code -eq 0 ] && return 0
+    n=$((n + 1)); [ $n -ge 3 ] && return $code
+    sleep 10
+  done
+}
+# The previous sha's Worker redeployed to production (docs/CLOUDFLARE.md 5.6 item 3): the worktree
+# is checked out at $1 (the last deployed sha), the Worker deployed with that sha's stamp and
+# /health read, then the worktree checked out at $2 again. Prints one sentence for the log.
+worker_rollback() {
+  local prev=$1 cur=$2 result
+  if [ -z "$prev" ]; then echo "no previous sha in gt-follow.last; the Worker stays at $cur"; return 1; fi
+  if ! git -C "$WT" checkout -q --detach "$prev" 2>>"$LOG"; then echo "checkout of $prev for the Worker rollback failed; the Worker stays at $cur"; return 1; fi
+  if worker_deploy production "$prev" "" "$GUARD/rollback-worker-$(date -u +%Y%m%dT%H%M%SZ)-${prev:0:8}.out"; then
+    worker_health "$(cf_host production)" "$prev" ""
+    result="rolled the Worker back to $prev ($WORKER_HEALTH)"
+  else
+    result="the Worker rollback to $prev failed: $WORKER_NOTE"
+  fi
+  git -C "$WT" checkout -q --detach "$cur" 2>>"$LOG"
+  echo "$result"
+}
