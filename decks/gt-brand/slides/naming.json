        "cells": [
          {
            "blocks": [
              {
                "id": "p1",
                "type": "paragraph",
                "text": "The name General Translation was chosen for three reasons, in priority order.",
                "measure": 56
              }
            ]
          },
          {
            "blocks": [
              {
                "id": "p2",
                "type": "paragraph",
                "text": "The first is ambition. As with General Motors or General Electric, the name signals the intent to be the leading company in the category.",
                "measure": 56
              }
            ]
          },
          {
            "blocks": [
              {
                "id": "p3",
                "type": "paragraph",
                "text": "The second is generality. General AI models understand context and follow instructions better than specialized translation models.",
                "measure": 56
              }
            ]
          },
          {
            "blocks": [
              {
                "id": "p4",
                "type": "paragraph",
                "text": "The third is distinction. Most other localization companies have names beginning with L.",
                "measure": 56
              }
            ]
          }
        ]
      },
