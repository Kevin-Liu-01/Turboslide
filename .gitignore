node_modules
dist
# .turboslide at any depth: the repo's render and e2e scratch, .turboslide/token (the per checkout
# agent token), .turboslide/session-secret, .turboslide/principals and decks/<id>/.turboslide/access.json
# (gslides-parity SPEC-3 2.2, 7.1, 7.7)
.turboslide
.output
coverage
*.log
.DS_Store
.turbo

# Derived by the toolchain
.tanstack
.nitro
.vercel
apps/studio/src/routeTree.gen.ts
*.tsbuildinfo

# Local environment
.env
*.local

# Rust crate build outputs (docs/native.md); Cargo.lock stays tracked. Round four (gslides-parity
# SPEC-4 0.38) commits two outputs as build products regenerated by CI (.github/workflows/native.yml)
# with their sha256 in packages/native/BUILD-RECORD.json: the wasm module under packages/native/wasm/
# (the glue, the .wasm and the two .d.ts files) and the Linux x64 glibc addon. Every other platform's
# addon stays untracked. packages/native/npm/linux-x64-gnu/.gitignore (B4's file) must drop its own
# `*.node` line for the negation below to take effect (a nested ignore outranks the root's).
crates/*/target
*.node
!packages/native/npm/linux-x64-gnu/turboslide-native.linux-x64-gnu.node

# A deck's comment threads name people (gslides-parity SPEC-3 2.2): gitignored in this public
# repository; a private deck repository removes the one line. The pattern is one level deep, so
# the fixture threads under decks/fixture/gslides/comments/ stay tracked (MILESTONES-3 B1).
decks/*/comments/

# Python bytecode the fonts script leaves beside itself (round four ship step, VERIFICATION-4 finding 20)
__pycache__/
