{
  "name": "@turboslide/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The action dispatcher and the contracts generator (pnpm generate:contracts): CLI option parsers, the MCP tool list JSON, describe().actions, openapi.json, the agent manifest, the llms guides, docs/grammar.md and the skills reference tables, with a stale-file test; the window API behind window.turboslide.studio (registry, adapter, controls, invoke, ready, history); and the framework-free HTTP transport (auth, dispatch, errors, manifest, readers, attached sessions) the studio serves at /api/actions and /api/agent.",
  "scripts": {
    "generate": "node src/generate/main.ts",
    "generate:check": "node src/generate/main.ts --check",
    "test": "vitest run"
  },
  "exports": {
    "./dispatch": "./src/dispatch.ts",
    "./generate/contracts": "./src/generate/contracts.ts",
    "./generate/cli": "./src/generate/cli.ts",
    "./generate/mcp": "./src/generate/mcp.ts",
    "./generate/describe": "./src/generate/describe.ts",
    "./generate/openapi": "./src/generate/openapi.ts",
    "./generate/manifest": "./src/generate/manifest.ts",
    "./generate/grammar": "./src/generate/grammar.ts",
    "./generate/skills": "./src/generate/skills.ts",
    "./generate/llms": "./src/generate/llms.ts",
    "./http/auth": "./src/http/auth.ts",
    "./http/dispatch": "./src/http/dispatch.ts",
    "./http/errors": "./src/http/errors.ts",
    "./http/manifest": "./src/http/manifest.ts",
    "./http/readers": "./src/http/readers.ts",
    "./http/sessions": "./src/http/sessions.ts",
    "./window/adapter": "./src/window/adapter.ts",
    "./window/controls": "./src/window/controls.ts",
    "./window/history": "./src/window/history.ts",
    "./window/invoke": "./src/window/invoke.ts",
    "./window/ready": "./src/window/ready.ts",
    "./window/registry": "./src/window/registry.ts",
    "./generated/cli.json": "./generated/cli.json",
    "./generated/mcp-tools.json": "./generated/mcp-tools.json",
    "./generated/describe.json": "./generated/describe.json",
    "./generated/openapi.json": "./generated/openapi.json",
    "./generated/manifest.json": "./generated/manifest.json",
    "./generated/llms.txt": "./generated/llms.txt",
    "./generated/llms-full.txt": "./generated/llms-full.txt",
    "./index": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@turboslide/headless": "workspace:*",
    "@turboslide/lint": "workspace:*",
    "@turboslide/render": "workspace:*",
    "@turboslide/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
