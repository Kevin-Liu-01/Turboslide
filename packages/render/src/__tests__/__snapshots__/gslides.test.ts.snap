exports[`the parity round render cases in both themes > renders a multiline paragraph as one .para span per paragraph (dark) 1`] = `"<p class="max-p" data-block="p1" data-type="paragraph" data-run="p1/text"><span class="para">The first paragraph.</span><span class="para">The second paragraph follows a break.</span><span class="para"></span><span class="para">A fourth after an empty one.</span></p>"`;

exports[`the parity round render cases in both themes > renders a multiline paragraph as one .para span per paragraph (light) 1`] = `"<p class="max-p" data-block="p1" data-type="paragraph" data-run="p1/text"><span class="para">The first paragraph.</span><span class="para">The second paragraph follows a break.</span><span class="para"></span><span class="para">A fourth after an empty one.</span></p>"`;

exports[`the parity round render cases in both themes > renders a numbered plain list with the numeral outside the text carrier (dark) 1`] = `"<div class="plain numbered" data-block="list" data-type="plain"><span class="item"><span class="num" data-num="list/items/0">1</span><span data-run="list/items/0/text">Connect the repository</span></span><span class="item"><span class="num" data-num="list/items/1">2</span><span data-run="list/items/1/text">Pick the locales</span></span><span class="item"><span class="num" data-num="list/items/2">3</span><span data-run="list/items/2/text"><span class="prompt" data-prompt aria-hidden="true">Click to add text</span></span></span></div>"`;

